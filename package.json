{
  "name": "di-framework-examples",
  "version": "6.0.1",
  "private": true,
  "type": "module",
  "license": "(MIT OR Apache-2.0)",
  "author": "@di-framework Contributors",
  "repository": "https://github.com/di-framework/examples",
  "workspaces": [
    "framework/*",
    "platform/*",
    "platform/warehouse/packages/*",
    "platform/kube-apps/apps/*",
    "platform/plugin-workspace/services/*",
    "adapters/*",
    "agents/*"
  ],
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun x tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@di-framework/ai": "^6",
    "@di-framework/ai-utils": "^6",
    "@di-framework/bindings": "^6",
    "@di-framework/cli-plugin-platform": "file:../cli-extensions/packages/cli-plugin-platform",
    "@di-framework/platform": "^6"
  }
}
