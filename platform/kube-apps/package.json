{
  "name": "di-framework-kube-examples",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "check": "bun run prepare:features && tsc --noEmit",
    "test": "bun test",
    "deploy": "bun scripts/deploy.ts",
    "smoke": "bun scripts/smoke.ts",
    "smoke:tls": "bun scripts/tls-smoke.ts",
    "link:framework": "bun scripts/link-framework.ts",
    "runtime:tls": "bun scripts/tls-runtime.ts",
    "verify:tls": "bun run deploy node-tls && bun run smoke node-tls",
    "prepare:features": "bun scripts/prepare-features.ts",
    "test:features": "bun run prepare:features && bun test tests/features.test.ts",
    "verify:features": "bun scripts/verify-features.ts"
  },
  "dependencies": {
    "@di-framework/core": "^6.0.6",
    "@di-framework/http": "^6.0.6",
    "@di-framework/actors": "^6.0.6",
    "@di-framework/queues": "^6.0.6",
    "@di-framework/repo": "^6.0.6",
    "@di-framework/bindings": "^6"
  },
  "devDependencies": {
    "@di-framework/cli": "^6",
    "@di-framework/cli-extension": "^6",
    "@di-framework/cli-plugin-platform": "^6",
    "@types/bun": "1.3.14",
    "rolldown": "1.2.7",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/examples",
    "directory": "platform/kube-apps"
  },
  "bugs": {
    "url": "https://github.com/di-framework/examples/issues"
  },
  "homepage": "https://github.com/di-framework/examples",
  "version": "6.0.2"
}
